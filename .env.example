# Copy to .env.local (gitignored) and fill in. Both apps read this file.

# Supabase → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the phone app (the Railway domain). The laptop encodes it in the QR code.
# Local testing: http://<laptop-LAN-IP>:5174/  (leave empty to default to this machine on port 5174)
VITE_COMPANION_URL=https://your-companion.up.railway.app/
